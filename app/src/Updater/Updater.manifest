<?xml version="1.0" encoding="utf-8"?>
<!-- URnetwork update helper manifest. asInvoker: the tray app asks for
     elevation itself ("runas"), and the installer's relaunch must start
     unelevated, so the executable never asks on its own. Declaring the level
     also keeps Windows' installer detection, which elevates programs named
     like updaters, away from it.
     SPDX-License-Identifier: MPL-2.0 -->
<assembly manifestVersion="1.0" xmlns="urn:schemas-microsoft-com:asm.v1">
  <assemblyIdentity type="win32" name="URnetwork.Update" version="0.0.1.0" />

  <compatibility xmlns="urn:schemas-microsoft-com:compatibility.v1">
    <application>
      <!-- Windows 10 and 11 -->
      <supportedOS Id="{8e0f7a12-bfb3-4fe8-b9a5-48fd50a15a9a}" />
    </application>
  </compatibility>

  <trustInfo xmlns="urn:schemas-microsoft-com:asm.v3">
    <security>
      <requestedPrivileges>
        <requestedExecutionLevel level="asInvoker" uiAccess="false" />
      </requestedPrivileges>
    </security>
  </trustInfo>
</assembly>
