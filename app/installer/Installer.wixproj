<Project Sdk="WixToolset.Sdk/5.0.2">
  <!-- URnetwork MSI. Build: dotnet build -c Release -p:Platform=x64 (or ARM64).
       BinDir must point at the staged binaries (app + service + wintun + driver).
       SPDX-License-Identifier: MPL-2.0 -->
  <PropertyGroup>
    <OutputName>URnetwork</OutputName>
    <OutputType>Package</OutputType>
    <!-- default staging dir; override on the command line per arch/config -->
    <BinDir Condition="'$(BinDir)'==''">$(MSBuildThisFileDirectory)..\build\$(Platform)\Release</BinDir>
    <!-- MSI ProductVersion fields are 16-bit-bounded (and the first two
         effectively 8-bit), so the MSI cannot carry the app's yyyy.M.d date.
         build.ps1 and CI pass -p:UrMsiVersion from tools/UrVersion.ps1,
         (Y-2000).M.<time of month>, which rises with the release code. The
         default, 0.0.1, keeps a bare `dotnet build` and build.ps1's 0.0.0-0
         compiling. A 0.0.1 package replaces any installed 0.0.1 product of
         this UpgradeCode, which includes every official MSI built before
         build.ps1 stamped versions; any stamped package replaces it, and it
         is refused over a stamped one. -->
    <UrMsiVersion Condition="'$(UrMsiVersion)'==''">0.0.1</UrMsiVersion>
    <DefineConstants>BinDir=$(BinDir);UrMsiVersion=$(UrMsiVersion)</DefineConstants>
    <!-- -p:IncludeDriver=true (build.ps1 -IncludeDriver) compiles the split-tunnel
         driver component into the package; otherwise the .sys is omitted so the MSI
         builds without the (WDK-built) driver. -->
    <DefineConstants Condition="'$(IncludeDriver)'=='true'">$(DefineConstants);IncludeDriver</DefineConstants>
    <!-- Installer warnings describe upgrade/repair correctness, not polish.
         The two ICE exceptions below are suppressed, each for its stated
         reason; every other WiX warning must stop the package build. -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- ICE03 (generic column-type/range validation across standard MSI tables)
         fails post-build on the harvested WindowsAppRuntime payload, not on
         anything this project authors: some locale .mui satellites carry a
         single LCID (observed: 1152/1153/1169 — ug-CN/mi-NZ/gd-gb) that
         predates ICE03's bundled reference table, and Microsoft.ui.xaml.dll /
         Microsoft.UI.Xaml.Phone.dll each declare ~89 languages, whose
         comma-joined list overflows the File table's Language column length.
         Confirmed locally (pinned wix.exe 5.0.2, `wix msi validate`) that
         neither File/@Language (not a valid attribute in this WiX version)
         nor File/@CompanionFile (accepted, but does not stop WiX from
         auto-populating/validating Language on the companioned file either)
         can override this per file — there is no per-file or per-table
         escape hatch, only this package-wide one. This column is otherwise
         inert for this MSI: Package has no Language/Languages/transforms and
         nothing here builds an MSP, so nothing in this package's install
         logic reads it; the OS resource loader never consults MSI metadata
         at all. Suppressing ICE03 does NOT suppress other ICEs — confirmed
         locally that ICE60 still runs with ICE03 suppressed. Private app
         fonts are authored explicitly as companion files of the versioned app
         executable in Package.wxs.

         ICE61 checks the Upgrade table. With MajorUpgrade
         AllowSameVersionUpgrades="yes" (Package.wxs) it reports one row, on
         purpose: the upgrade row's maximum version is this package's own
         ProductVersion, inclusive ("The Maximum version is not less than the
         current product", followed by that version twice). Two release codes
         can share a ProductVersion, and either must replace the other rather
         than install beside it. That expected row is ICE61's only message
         today, but the suppression is package-wide: it would also hide every
         other ICE61 check on any Upgrade row authored here later. Suppressing
         ICE61 does not suppress other ICEs. -->
    <SuppressIces>ICE03;ICE61</SuppressIces>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="WixToolset.Util.wixext" Version="5.0.2" />
    <PackageReference Include="WixToolset.Firewall.wixext" Version="5.0.2" />
  </ItemGroup>
</Project>
